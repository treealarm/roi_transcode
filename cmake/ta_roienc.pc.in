prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ta_roienc
Description: @TA_ROIENC_PC_DESCRIPTION@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -l@TA_ROIENC_PC_LIBRARY@
Requires.private: @TA_ROIENC_PC_REQUIRES_PRIVATE@
