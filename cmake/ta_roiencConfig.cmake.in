@PACKAGE_INIT@

# find_package(ta_roienc CONFIG) gives ta_roienc::ta_roienc and whichever components this
# build installed.
# The components are separate on purpose: they are explicitly linkable and must not become
# transitive dependencies of the core.
include("${CMAKE_CURRENT_LIST_DIR}/ta_roiencTargets.cmake")

set(TA_ROIENC_COMPONENTS @TA_ROIENC_INSTALLED_COMPONENTS@)
check_required_components(ta_roienc)
