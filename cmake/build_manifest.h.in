inline constexpr const char* kBuildType = "@CMAKE_BUILD_TYPE@";
inline constexpr const char* kCxxStandard = "@CMAKE_CXX_STANDARD@";
inline constexpr const char* kX264Version = "@X264_VERSION@";
inline constexpr const char* kX265Version = "@X265_VERSION@";
inline constexpr const char* kFfmpegLibavutilVersion = "@FFMPEG_libavutil_VERSION@";
inline constexpr const char* kFeatures = "@SVE_MANIFEST_FEATURES_TEXT@";

/// Linking libx264 and libx265 directly puts the artefact under the GPL, which the
/// FFmpeg-mediated path used to hide behind ffmpeg[gpl]. §55 wants a licence review before
/// release, and this is where a packager finds out there is one to do.
inline constexpr const char* kLicense = "GPL-2.0-or-later (libx264/libx265 are linked directly)";

