# Every build directory, not a list of the ones that existed when this was written.
# CMakePresets alone defines build, build-cli, build-release and build-software, and
# build-software was missing here; a dependency-scan or sanitizer tree (build-asan,
# build-prof-*) is not in any preset and would have been missed too. One pattern cannot
# fall behind the way an enumeration does.
/build*/
/out/
/.cache/
# Python leaves these beside any script it runs; the tree has had .py files since
# make-scenes.py and picked up a bench of its own on 2026-08-31.
__pycache__/
*.pyc
*.mp4
!testdata/*.json
# Fetched by scripts/fetch-intel-qsv.sh — the Intel VA-API driver, ~61 MB. Not a
# build dependency and not something vcpkg carries: it is a GPU driver, matched
# to the kernel and the card, so it is fetched rather than vendored.
/runtime/
# Regenerated by scripts/make-synth.sh and scripts/make-scenes.py.
/testdata/eval/
/testdata/scenes/
