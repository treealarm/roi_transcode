{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-default",
      "displayName": "Linux Debug (vcpkg grpc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/mnt/wdblue/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "ROI_BUILD_SVC": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (vcpkg grpc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/mnt/wdblue/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "ROI_BUILD_SVC": "ON"
      }
    },
    {
      "name": "linux-cli-only",
      "displayName": "Linux CLI only (no gRPC, no repo protos)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cli",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROI_BUILD_SVC": "OFF"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "ROI_BUILD_SVC": "ON"
      }
    }
  ]
}
