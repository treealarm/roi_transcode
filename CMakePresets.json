{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "$comment-compile-commands": "The compile database, for the editor. Without it IntelliSense guesses the language standard and the include paths, and guesses them wrong: it reported std::span as missing from a tree that compiles, because it had defaulted to C++17 and knew nothing of vcpkg's FFmpeg. Every preset inherits this, so the database exists wherever anyone builds.",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-dev",
      "inherits": "vcpkg-base",
      "displayName": "Linux Debug, classic vcpkg (fast inner loop)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SVE_BUILD_INTEGRATION": "ON",
        "$comment": "Manifest mode off deliberately: this preset reuses the tree already installed in VCPKG_ROOT, which is what makes a reconfigure take a second instead of rebuilding gRPC. The manifest presets are what a fresh checkout and the acceptance criteria use.",
        "VCPKG_MANIFEST_MODE": "OFF"
      }
    },
    {
      "name": "linux-default",
      "inherits": "vcpkg-base",
      "displayName": "Linux Debug (library + tools + gRPC service)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SVE_BUILD_INTEGRATION": "ON",
        "VCPKG_MANIFEST_FEATURES": "intel;tools;service"
      }
    },
    {
      "name": "linux-release",
      "inherits": "vcpkg-base",
      "displayName": "Linux Release (library + tools + gRPC service)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SVE_BUILD_INTEGRATION": "ON",
        "VCPKG_MANIFEST_FEATURES": "intel;tools;service"
      }
    },
    {
      "name": "linux-cli-only",
      "inherits": "vcpkg-base",
      "displayName": "Linux Release, no gRPC (library + CLI)",
      "binaryDir": "${sourceDir}/build-cli",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SVE_BUILD_INTEGRATION": "OFF",
        "VCPKG_MANIFEST_FEATURES": "intel;tools"
      }
    },
    {
      "name": "linux-software-only",
      "inherits": "vcpkg-base",
      "displayName": "Linux Release, software encoders only (no Intel hardware)",
      "binaryDir": "${sourceDir}/build-software",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SVE_BUILD_INTEGRATION": "OFF",
        "VCPKG_MANIFEST_FEATURES": "tools"
      }
    },
    {
      "name": "windows-default",
      "inherits": "vcpkg-base",
      "displayName": "Windows x64 Debug",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SVE_BUILD_INTEGRATION": "ON",
        "VCPKG_MANIFEST_FEATURES": "tools;service"
      }
    }
  ]
}
