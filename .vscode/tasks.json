{
  // Editor tasks for the things this repository is actually driven by. Not a substitute
  // for the scripts -- every task below runs one of them, so what the editor does and what
  // a terminal does cannot drift apart.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bench: serve (ROI quality, browser)",
      "detail": "Local bench at http://127.0.0.1:8765 -- original beside ROI-encoded, the knobs, the difference view. Needs integration/ built.",
      "type": "shell",
      "command": "python3",
      "args": ["integration/bench/serve.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "BUILD": "${workspaceFolder}/build/integration" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "build (library + integration)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "-j", "${env:NPROC}"],
      "options": { "cwd": "${workspaceFolder}", "env": { "NPROC": "8" } },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "configure (linux-dev preset)",
      "detail": "Reconfigure from scratch. A stale CMakeCache is what makes an FFmpeg feature change look like a source error -- see CLAUDE.md.",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "linux-dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "VCPKG_ROOT": "/mnt/wdblue/vcpkg" }
      },
      "problemMatcher": []
    },
    {
      "label": "unit tests (ctest)",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "build", "--output-on-failure"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "acceptance (check.sh)",
      "detail": "The full run. Read the step count, not just the last line -- CLAUDE.md explains why.",
      "type": "shell",
      "command": "./integration/scripts/check.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD": "${workspaceFolder}/build/integration",
          "LIBBUILD": "${workspaceFolder}/build"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dependency scan (§26.4, §44)",
      "detail": "Configures a shared build, installs it, and reads what each object links. Costs a Release build from scratch.",
      "type": "shell",
      "command": "./integration/scripts/dependency-scan.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "VCPKG_ROOT": "/mnt/wdblue/vcpkg" }
      },
      "problemMatcher": []
    },
    {
      "label": "capabilities (§23)",
      "type": "shell",
      "command": "./build/sve-capabilities",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
