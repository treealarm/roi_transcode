{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "unitTest",
      "type": "pickString",
      "description": "Which unit test to debug",
      "default": "encoder_test",
      "options": [
        "encoder_test", "decoder_test", "frame_test", "backend_conformance_test",
        "ten_bit_test", "public_api_test", "sei_payload_test", "cbor_test",
        "object_normalizer_test", "object_geometry_test", "geometry_test",
        "importance_test", "temporal_roi_test", "bitrate_budget_test", "region_policy_test"
      ]
    }
  ],
  "configurations": [
    {
      "name": "C++: unit test (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${input:unitTest}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "readable containers", "text": "-enable-pretty-printing",
          "ignoreFailures": true }
      ],
      "preLaunchTask": "build"
    }
  ]
}
