{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "unitTest",
      "type": "pickString",
      "description": "Which unit test to debug",
      "default": "encode_test",
      "options": [
        "encode_test", "decode_test", "picture_test", "engine_conformance_test",
        "ten_bit_samples_test", "api_surface_test", "sei_record_test", "cbor_io_test",
        "object_cleanup_test", "object_shapes_test", "shapes_test",
        "weighting_test", "roi_memory_test", "bit_allowance_test", "region_rules_test"
      ]
    }
  ],
  "configurations": [
    {
      "name": "C++: unit test (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${input:unitTest}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "readable containers", "text": "-enable-pretty-printing",
          "ignoreFailures": true }
      ],
      "preLaunchTask": "build"
    }
  ]
}
